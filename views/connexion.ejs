<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Foodercato - Connexion administration">
  <title>Connexion - Foodercato</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/favicon.ico">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content" role="main">
    <div class="container" style="max-width: 450px; margin: 3rem auto;">
      <div class="card" style="background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); padding: 2.5rem;">
        <header style="text-align: center; margin-bottom: 2rem;">
          <img src="/images/logo.png" alt="Foodercato" style="height: 60px; margin-bottom: 1rem;">
          <h1 style="color: #123BDA; font-size: 1.75rem;">Administration</h1>
          <p style="color: #666;">Connectez-vous pour gérer les articles</p>
        </header>

        <form id="login-form" novalidate>
          <div style="margin-bottom: 1.5rem;">
            <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #333;">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email"
              style="width: 100%; padding: 0.75rem 1rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem; transition: border-color 0.2s;"
              placeholder="admin@foodercato.com">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label for="password" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #333;">Mot de passe</label>
            <input type="password" id="password" name="password" required autocomplete="current-password"
              style="width: 100%; padding: 0.75rem 1rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem; transition: border-color 0.2s;"
              placeholder="••••••••">
          </div>

          <div id="login-error" style="background: #fee; color: #c00; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; display: none;"></div>

          <button type="submit"
            style="width: 100%; background: #123BDA; color: #fff; border: none; padding: 0.875rem; font-size: 1rem; font-weight: 600; border-radius: 8px; cursor: pointer; transition: background 0.2s;">
            Se connecter
          </button>
        </form>

        <p style="text-align: center; margin-top: 1.5rem; color: #666; font-size: 0.9rem;">
          <a href="/" style="color: #123BDA; text-decoration: none;">← Retour à l'accueil</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/connexion.js"></script>
</body>
</html>