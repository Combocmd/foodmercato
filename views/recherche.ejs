<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Foodercato - Recherche">
  <title>Recherche - Foodercato</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/favicon.ico">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content" role="main">
    <div class="container">
      <header class="page-header" style="padding: 2rem 0;">
        <h1 style="color: #123BDA; margin-bottom: 0.5rem;">Résultats de recherche</h1>
        <p style="color: #666;">Pour "<%= q || '' %>"</p>
      </header>

      <section id="search-results" class="articles-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
        <div class="loading" style="grid-column: 1/-1; text-align: center; padding: 3rem;">
          <div class="spinner-border text-warning" role="status"><span class="visually-hidden">Chargement...</span></div>
          <p class="mt-2">Recherche en cours...</p>
        </div>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/recherche.js"></script>
</body>
</html>